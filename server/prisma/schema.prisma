// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        Int      @id @default(1)
  headline  String
  aboutMe   String   @db.Text
  updatedAt DateTime @updatedAt
}

model SkillCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  order  Int     @default(0)
  skills Skill[]
}

model Skill {
  id         String        @id @default(uuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Employment {
  id               String   @id @default(uuid())
  role             String
  organization     String
  duration         String
  responsibilities String[]
  order            Int      @default(0)
}

model Education {
  id        String @id @default(uuid())
  degree    String
  institute String
  duration  String
  order     Int    @default(0)
}

model Certification {
  id          String @id @default(uuid())
  name        String
  institute   String
  duration    String
  description String @db.Text
  order       Int    @default(0)
}
